{
  "projectName": "PersonalProject",
  "projectDescription": "Solo developer project with simple coordination needs",
  "currentPhase": "Development",
  "agentMode": "single",
  "agentCount": 1,
  "agentRoles": ["FullStack"],
  "docsAgent": "FullStack-1",
  "mainBranch": "main",
  "frontendDir": "src/",
  "backendDir": "api/",
  "migrationsDir": "db/migrations/",
  "testsDir": "tests/",
  "frontendFramework": "Next.js",
  "backendFramework": "Next.js API Routes",
  "database": "SQLite",
  "buildTool": "Next.js",
  "packageManager": "npm",
  "frontendZones": [
    "src/**",
    "components/**",
    "pages/**",
    "styles/**"
  ],
  "backendZones": [
    "api/**",
    "lib/**",
    "db/**"
  ],
  "sharedZones": [
    "package.json",
    "tsconfig.json",
    "next.config.js",
    "README.md"
  ],
  "forbiddenMods": [
    ".git/",
    "node_modules/",
    ".next/",
    ".env.local"
  ],
  "commitFormat": "conventional",
  "typescriptStrict": true,
  "testCoverageMin": 70,
  "changelogFormat": "keepachangelog",
  "enablePreCommitHooks": false,
  "createInitialCommit": true
}
