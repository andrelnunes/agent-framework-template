{
  "name": "agent-framework-template",
  "version": "2.0.0",
  "description": "Spec-driven engineering kit for AI coding agents: PRD → backlog → branch → quality gate → PR, enforced by hooks and CI. Drop-in for new or existing repos.",
  "type": "module",
  "bin": {
    "agent-framework-template": "init.js"
  },
  "main": "init.js",
  "files": [
    "init.js",
    "CLAUDE.md",
    "MIGRATION.md",
    ".claude",
    ".github",
    "docs",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "init": "node init.js",
    "selftest": "node init.js --test",
    "test": "node init.js --test && node --test"
  },
  "keywords": [
    "spec-driven-development",
    "ai-agents",
    "claude-code",
    "cursor",
    "openai-codex",
    "git-worktree",
    "development-framework",
    "conventional-commits"
  ],
  "author": "André Nunes <contact@tekverso.com> (https://tekverso.com)",
  "contributors": [
    "André Nunes (https://github.com/andrelnunes)"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/andrelnunes/agent-framework-template"
  },
  "homepage": "https://github.com/andrelnunes/agent-framework-template#readme",
  "bugs": {
    "url": "https://github.com/andrelnunes/agent-framework-template/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
