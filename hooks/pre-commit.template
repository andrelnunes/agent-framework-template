#!/bin/bash
# Agent Framework Pre-Commit Hook
# Version: 1.0.0
# Generated by: agent-framework-template
#
# This hook enforces agent framework compliance before commits.
# To disable temporarily: git commit --no-verify
# To disable permanently: rm .git/hooks/pre-commit

set -e

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🤖 Running agent framework pre-commit checks...${NC}"

# ============================================================================
# Configuration (generated from init.js)
# ============================================================================

AGENT_MODE="{{AGENT_MODE}}"  # single or multi
COMMIT_FORMAT="{{COMMIT_FORMAT}}"  # conventional or free
MAIN_BRANCH="{{MAIN_BRANCH}}"  # main or master
PROJECT_NAME="{{PROJECT_NAME}}"

# ============================================================================
# Helper Functions
# ============================================================================

function warn() {
  echo -e "${YELLOW}⚠️  Warning: $1${NC}"
}

function error() {
  echo -e "${RED}❌ Error: $1${NC}"
}

function success() {
  echo -e "${GREEN}✅ $1${NC}"
}

function info() {
  echo -e "${BLUE}ℹ️  $1${NC}"
}

function ask_continue() {
  local message="$1"
  echo -e "${YELLOW}$message${NC}"
  read -p "Continue anyway? (y/n) " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    error "Commit aborted by user"
    exit 1
  fi
}

# ============================================================================
# Check 1: Multi-Agent - STATUS.md Updated When backlog.md Changes
# ============================================================================

if [ "$AGENT_MODE" = "multi" ]; then
  if git diff --cached --name-only | grep -q "backlog.md"; then
    if ! git diff --cached --name-only | grep -q ".agent-framework/core/STATUS.md"; then
      warn "backlog.md changed but STATUS.md not updated"
      info "When updating tasks, you should also update agent coordination state"
      ask_continue "Commit without STATUS.md update?"
    else
      success "backlog.md and STATUS.md both updated"
    fi
  fi
fi

# ============================================================================
# Check 2: Multi-Agent - File Reservations Compliance
# ============================================================================

if [ "$AGENT_MODE" = "multi" ]; then
  # Check if any files being committed are listed in STATUS.md FILE RESERVATIONS
  # by another agent
  if [ -f ".agent-framework/core/STATUS.md" ]; then
    changed_files=$(git diff --cached --name-only)

    # Simple check: if STATUS.md exists and files are changing,
    # warn user to verify reservations manually
    if [ -n "$changed_files" ]; then
      info "Modified files detected - verify no files are reserved by other agents"
      # Note: Full parsing of STATUS.md would require more complex logic
      # For now, trust agents to follow protocols
    fi
  fi
fi

# ============================================================================
# Check 3: Conventional Commits Format
# ============================================================================

if [ "$COMMIT_FORMAT" = "conventional" ]; then
  # Get commit message (works for git commit -m "message")
  COMMIT_MSG_FILE=".git/COMMIT_EDITMSG"

  if [ -f "$COMMIT_MSG_FILE" ]; then
    COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

    # Regex for conventional commits: type(scope): subject
    # Types: feat, fix, docs, style, refactor, test, chore
    if [[ ! "$COMMIT_MSG" =~ ^(feat|fix|docs|style|refactor|test|chore)(\(.+\))?: ]]; then
      error "Invalid commit message format"
      info "Expected format: type(scope): subject"
      info "Valid types: feat, fix, docs, style, refactor, test, chore"
      info ""
      info "Examples:"
      info "  feat(auth): Add JWT token refresh"
      info "  fix(api): Resolve race condition in user lookup"
      info "  docs: Update API documentation"
      info ""
      info "Your message: $COMMIT_MSG"
      exit 1
    else
      success "Commit message format valid"
    fi
  fi
fi

# ============================================================================
# Check 4: Forbidden File Modifications
# ============================================================================

FORBIDDEN_PATTERNS=(
  "\.env$"
  "\.env\.local$"
  "\.env\.production$"
  "node_modules/"
  "\.git/"
)

changed_files=$(git diff --cached --name-only)

for file in $changed_files; do
  for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
    if [[ $file =~ $pattern ]]; then
      error "Attempting to commit forbidden file: $file"
      info "Files matching pattern '$pattern' should not be committed"
      ask_continue "Commit forbidden file?"
    fi
  done
done

# ============================================================================
# Check 5: Update Timestamps in STATUS.md (Multi-Agent)
# ============================================================================

if [ "$AGENT_MODE" = "multi" ]; then
  if git diff --cached --name-only | grep -q ".agent-framework/core/STATUS.md"; then
    # Optionally auto-update timestamps
    # Note: This would require parsing and updating STATUS.md
    # For now, just verify it's being updated
    success "STATUS.md updated in this commit"
  fi
fi

# ============================================================================
# Check 6: CHANGELOG.md Updated for User-Facing Changes
# ============================================================================

# If certain files changed, suggest CHANGELOG update
USER_FACING_PATTERNS=(
  "src/components/"
  "src/pages/"
  "api/"
  "server/"
)

changed_files=$(git diff --cached --name-only)
user_facing_changed=false

for file in $changed_files; do
  for pattern in "${USER_FACING_PATTERNS[@]}"; do
    if [[ $file =~ $pattern ]]; then
      user_facing_changed=true
      break 2
    fi
  done
done

if [ "$user_facing_changed" = true ]; then
  if ! git diff --cached --name-only | grep -q ".agent-framework/core/CHANGELOG.md"; then
    warn "User-facing code changed but CHANGELOG.md not updated"
    info "Consider adding entry to CHANGELOG.md for user visibility"
    ask_continue "Commit without CHANGELOG update?"
  else
    success "CHANGELOG.md updated with user-facing changes"
  fi
fi

# ============================================================================
# Check 7: Prevent Direct Commits to Main Branch (Optional)
# ============================================================================

current_branch=$(git symbolic-ref --short HEAD)

if [ "$current_branch" = "$MAIN_BRANCH" ]; then
  warn "Committing directly to $MAIN_BRANCH branch"
  info "Consider using feature branches and pull requests"
  ask_continue "Commit directly to $MAIN_BRANCH?"
fi

# ============================================================================
# Check 8: Framework Files Integrity
# ============================================================================

# Verify critical framework files exist
REQUIRED_FILES=(
  ".agent-framework/core/PLAYBOOK.md"
  ".agent-framework/core/RULES.md"
  ".agent-framework/core/CHANGELOG.md"
  "backlog.md"
)

if [ "$AGENT_MODE" = "multi" ]; then
  REQUIRED_FILES+=(".agent-framework/core/STATUS.md")
fi

for file in "${REQUIRED_FILES[@]}"; do
  if [ ! -f "$file" ]; then
    error "Required framework file missing: $file"
    info "Framework integrity compromised - reinitialize with agent-framework-template"
    exit 1
  fi
done

# ============================================================================
# All Checks Passed
# ============================================================================

echo ""
success "All pre-commit checks passed!"
echo -e "${BLUE}Proceeding with commit...${NC}"
echo ""

exit 0
